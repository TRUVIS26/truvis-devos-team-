# Required for `npm run check:env`. Match these to your project's actual integrations.
# Placeholder values will cause `check:env` to fail with a "still contains a placeholder value" message — that's intended.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — remove if your project has no payment surface
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email — remove if your project uses a different transactional provider
RESEND_API_KEY=re_...
FROM_EMAIL=info@example.com

# Add your project-specific env vars below (Anthropic, WATI, Inngest, Sentry, GA4, etc.)
# ANTHROPIC_API_KEY=sk-ant-...
# WATI_API_KEY=...
# WATI_API_ENDPOINT=https://live-mt-server.wati.io/<your-account>
# INNGEST_EVENT_KEY=...
# INNGEST_SIGNING_KEY=signkey-...
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# ADMIN_SETUP_SECRET=<choose-a-secret>
